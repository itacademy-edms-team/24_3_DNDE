{
  "ReverseProxy": {
    "Routes": {
      "spa": {
        "ClusterId": "spa-cluster",
        "Match": {
          "Path": "/{**catch-all}"
        }
      },
      "finance-api": {
        "ClusterId": "finance-api-cluster",
        "Match": {
          "Path": "/api/finance/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/finance"
          }
        ]
      }
    },
    "Clusters": {
      "spa-cluster": {
        "HttpRequest": {
          "Version": "1.1",
          "VersionPolicy": "RequestVersionExact"
        },
        "Destinations": {
          "spa": {
            "Address": "http://client.browser:5173"
          }
        }
      },
      "finance-api-cluster": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30",
          "Version": "1.1",
          "VersionPolicy": "RequestVersionExact"
        },
        "Destinations": {
          "finance-service": {
            "Address": "http://financetrack.finance.web:8080"
          }
        }
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    },
    "Filter": [
      {
        "Name": "ByExcluding",
        "Args": {
          "expression": "RequestPath like '%/node_modules/%'"
        }
      }
    ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  }
}
