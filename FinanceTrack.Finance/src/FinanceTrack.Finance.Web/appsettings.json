{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Authentication": {
    "Authority": "https://auth.ft.localhost/realms/FinanceTrack",
    "Audience": "FinanceTrack.Finance",
    "RequireHttps": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log.txt",
          "rollingInterval": "Day"
        }
      }
      //Uncomment this section if you'd like to push your logs to Azure Application Insights
      //Full list of Serilog Sinks can be found here: https://github.com/serilog/serilog/wiki/Provided-Sinks
      //{
      //  "Name": "ApplicationInsights",
      //  "Args": {
      //    "instrumentationKey": "", //Fill in with your ApplicationInsights InstrumentationKey
      //    "telemetryConverter": "Serilog.Sinks.ApplicationInsights.Sinks.ApplicationInsights.TelemetryConverters.TraceTelemetryConverter, Serilog.Sinks.ApplicationInsights"
      //  }
      //}
    ]
  },
  "Mailserver": {
    "FromEmail": "noreply@financetrack.local",
    "Hostname": "localhost",
    "Port": 16010
  },
  "YandexAi": {
    "Enabled": true,
    "ApiKey": "",
    "FolderId": "",
    "Model": "yandexgpt-lite"
  },
  "Notifications": {
    "TelegramBot": {
      "BotToken": "",
      "BotUsername": "financetrack_notifications_bot",
      "LinkingSessionLifetimeMinutes": 15
    }
  }
}
