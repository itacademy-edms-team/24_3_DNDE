{
  "NLog": {
    "extensions": [
      { "assembly": "NLog.Web.AspNetCore" }
    ],
    "throwConfigExceptions": true,
    "targets": {
      "logfile": {
        "type": "AsyncWrapper",
        "overflowAction": "Discard",
        "target": {
          "type": "File",
          "fileName": "${currentdir}/logs/${shortdate}.log",
          "layout": "${longdate}|${level:uppercase=true}|${logger}|${message} ${exception:format=tostring}"
        }
      },
      "logconsole": {
        "type": "AsyncWrapper",
        "overflowAction": "Discard",
        "target": {
          "type": "ColoredConsole",
          "layout": "${longdate}|${level:uppercase=true}|${message}"
        }
      }
    },
    "rules": [
      {
        "logger": "*",
        "minLevel": "Info",
        "writeTo": "logconsole",
        "filterDefaultAction": "Log",
        "filters": [
          {
            "type": "WhenContains",
            "layout": "${aspnet-request-url}",
            "substring": "/health",
            "action": "Ignore"
          }
        ]
      },
      {
        "logger": "*",
        "minLevel": "Debug",
        "writeTo": "logfile",
        "filterDefaultAction": "Log",
        "filters": [
          {
            "type": "WhenContains",
            "layout": "${aspnet-request-url}",
            "substring": "/health",
            "action": "Ignore"
          }
        ]
      }
    ]
  },
  "AllowedHosts": "*",
  "Oidc": {
    "Authority": "https://auth.localhost/realms/recallapp",
    "ClientId": "Bff.Web"
  }
}
