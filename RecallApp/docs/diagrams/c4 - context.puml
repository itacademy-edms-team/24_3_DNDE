@startuml C4 - Context - RecallApp
title Контекст системы RecallApp
top to bottom direction

!include <C4/C4_Context>

Person(personGuest, "Гость", "Неавторизованный посетитель")
Person(personUser, "Пользователь", "Учащиеся, студенты, родители. \n С учётной записью")
Person(personStaff, "Сотрудник", "Служебный персонал: администраторы и модераторы")

System(systemRecallApp, "RecallApp", "Система для запоминания учебного материала с поддержкой различных образовательных методик и форматов")

System_Ext(extSystemAuth, "OAuth-провайдер", "Вход через Яндекс, VK и другие соцсети")
System_Ext(extSystemObjectStorage, "Объектное хранилище", "Хранение медиафайлов: изображения, видео, аудио, документы")
System_Ext(extSystemPaymentGateway, "Платёжный провайдер", "Приём оплаты подписки")
System_Ext(extSystemEmail, "Email-провайдер", "Доставка писем на почту")
System_Ext(extSystemPush, "Push-провайдер", "Доставка push-уведомлений")
System_Ext(extSystemAiAgent, "ИИ-агент", "Внешний ИИ-ассистент пользователя")

Rel(personGuest, systemRecallApp, "Играет в матчах, видит лидерборд и свой результат; \n Смотрит фрагменты наборов")
Rel(personUser, systemRecallApp, "Создаёт и публикует наборы; \n Проходит и учит материал; \n Создаёт, хостит и играет в матчах; \n Состоит в учебных группах")
Rel(personStaff, systemRecallApp, "Управляет системой; \n Модерирует контент")

Rel(systemRecallApp, extSystemAuth, "Делегирует вход в систему", "OAuth 2.0 / OIDC")
Rel(systemRecallApp, extSystemObjectStorage, "Хранит и отдаёт медиафайлы", "S3 API / HTTPS")
Rel(systemRecallApp, extSystemPaymentGateway, "Проводит платежи и возвраты", "HTTPS")
Rel(systemRecallApp, extSystemEmail, "Рассылает письма", "SMTP / REST API")
Rel(systemRecallApp, extSystemPush, "Рассылает push-уведомления", "Web Push / REST API")
Rel_U(extSystemAiAgent, systemRecallApp, "Читает / меняет данные", "MCP")

SHOW_LEGEND()

@enduml