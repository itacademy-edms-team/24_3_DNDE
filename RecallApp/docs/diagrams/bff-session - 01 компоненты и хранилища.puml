@startuml bff-session-01-компоненты
title BFF-сессия: компоненты и хранилища (C0)

skinparam componentStyle rectangle
skinparam shadowing false
left to right direction

actor "Браузер" as browser

package "Bff.Web (процесс)" {
  package "Конвейер запроса" {
    component "RoutingMiddleware" as routemw
    component "AuthenticationMiddleware" as authmw
    component "TokenRefreshMiddleware" as trmw
    component "SessionGuardMiddleware\n/api: 401/403, сброс User после отказа" as guardmw
    component "..." as tbcmw
    component "AuthController\n/login /logout /session" as ctrl
  }

  package "Обработчики схем (фреймворк)" {
    component "CookieAuthenticationHandler\nсхема Cookies" as cookieh
    component "OpenIdConnectHandler\nсхема OpenIdConnect" as oidch
  }

  package "Наше" {
    component "ConfigureOidcOptions\nOnTokenValidated, OnTicketReceived" as cfg
    component "SessionCookieLifetime\nApply / ResetWindow" as scl
    component "TokenRefreshService\nкоординатор" as trs
    component "KeycloakTokenClient\ntyped HttpClient" as ktc
    component "SessionTokenWriter" as stw
    component "TokenRefreshSessionJanitor\nBackgroundService, 5 мин" as janitor
  }

  database "ITicketStore\nDistributedCacheTicketStore\n→ IDistributedCache (in-memory)" as store
  database "TokenRefreshSemaphores\nSemaphores / LastRefreshedAt /\nRetryNotBefore / RejectedSessions" as sems
}

database "Cookie recall_bff\n(в браузере)" as cookie
component "Keycloak\n(token-endpoint, сессии в БД)" as kc

browser --> routemw : каждый запрос
routemw --> authmw : next()
authmw --> oidch : callback?\n(/signin-oidc)
authmw --> cookieh : AuthenticateAsync(Cookies)
authmw --> trmw : next()
trmw --> trs : RefreshIfNeededAsync
trmw --> guardmw : next()
guardmw --> tbcmw: next()
tbcmw --> ctrl : endpoint.RequestDelegate(context);
ctrl ..> oidch : Challenge / SignOut
ctrl ..> cookieh : SignOut
guardmw ..> ctrl : /api без сессии: Challenge\n(событие OIDC → 401 problem+json)

cookieh --> cookie : читает / пишет\n(ключ стора, зашифрован)
cookieh --> store : Retrieve / Store /\nRenew / Remove
oidch --> kc : обмен кода, userinfo
oidch --> cfg : события
cfg --> scl : Apply
oidch --> cookieh : SignInAsync(Cookies)

trs --> sems : замок, метки времени
trs --> ktc : RefreshAsync
ktc --> kc : grant_type=refresh_token
trs --> stw : StoreRefreshedTokensAsync
stw --> scl : ResetWindow
stw --> cookieh : SignInAsync
trs --> cookieh : SignOutAsync
janitor --> sems : TryEvict

@enduml
