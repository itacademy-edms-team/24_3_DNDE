@startuml C4 - Containers - RecallApp
title Система RecallApp на уровне контейнеров
top to bottom direction

!include <C4/C4_Container>

Person(personGuest, "Гость", "Неавторизованный посетитель")
Person(personUser, "Пользователь", "Учащиеся, студенты, родители. \n С учётной записью")
Person(personStaff, "Сотрудник", "Служебный персонал: администраторы и модераторы")

Container(spa, "Веб-приложение", "React", "Приложение для гостей и пользователей")
Container(spaBackOffice, "Веб-приложение (BackOffice)", "React", "Административная панель для сотрудников")
Container(webBff, "Backend for Frontend публичного веб-приложения", "ASP.NET Core; OIDC confidential")
Container(webBackOfficeBff, "Backend for Frontend административной панели", "ASP.NET Core; OIDC confidential")
Container(iam, "Система управления пользователями и их глобальными/служебными ролями", "Keycloak")
Container(tbd, "...")

Rel(personGuest, spa, "Играет в матчах, видит лидерборд и свой результат; \n Смотрит фрагменты наборов", "HTTPS")
Rel(personUser, spa, "Создаёт и публикует наборы; \n Проходит и учит материал; \n Создаёт, хостит и играет в матчах; \n Состоит в учебных группах", "HTTPS")
Rel(personStaff, spaBackOffice, "Управляет системой; \n Модерирует контент", "HTTPS")

Rel(spa, webBff, "Использует BFF для взаимодействия с backend-сервисами", "HTTPS")
Rel(spaBackOffice, webBackOfficeBff, "Использует BFF для взаимодействия с backend-сервисами", "HTTPS")

Rel(webBff, iam, "Аутентифицирует пользователей, обменивает код на токены", "HTTPS / OIDC")
Rel(webBackOfficeBff, iam, "Аутентифицирует пользователей, обменивает код на токены", "HTTPS / OIDC")

Rel_R(webBff, tbd, "Взаимодействует с backend-сервисами", "HTTPS")
Rel_R(webBackOfficeBff, tbd, "Взаимодействует с backend-сервисами", "HTTPS")

SHOW_LEGEND()

@enduml