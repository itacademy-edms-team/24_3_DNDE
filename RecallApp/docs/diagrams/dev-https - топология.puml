@startuml dev-https-топология
title Локальная dev-топология: HTTPS для SPA + BFF + Keycloak (ADR 0026)

skinparam componentStyle rectangle
skinparam shadowing false
left to right direction

actor "Разработчик" as dev

package "Windows (host)" {
  component "Браузер" as browser
  database "Доверенные \n корневые ЦС" as winca
}

package "Docker-сеть dev_net" {
  component "edge-proxy (Nginx) \n :443 TLS + HTTP/2 \n aliases: \n - app.localhost \n - bff.localhost \n - auth.localhost" as edge
  component "spa (Vite) \n :5173" as spa
  component "bff (.NET) \n :5000" as bff
  component "iam (Keycloak) \n :8080  start-dev" as iam
  database "iam-db \n (Postgres)" as iamdb
  component "ca-generator \n (openssl)" as ca
  folder "shared_certs\n(volume) \n rootCA.pem + server.crt/key" as certs
}

dev --> browser

' front-channel: браузер всегда по https через edge-прокси
browser --> edge : https h2 \n app.localhost (SPA)
browser --> edge : https h2 \n bff.localhost (API, httpOnly cookie)
browser --> edge : https h2 \n auth.localhost (хостовые страницы входа)

' edge терминирует TLS, дальше http внутри сети
edge --> spa : http
edge --> bff : http
edge --> iam : http (X-Forwarded-Proto=https)

' back-channel: тот же https-адрес auth.localhost (alias заворачивает на edge)
bff --> edge : https \n auth.localhost (обмен кода на токен)
note on link
  issuer одинаков для браузера и BFF:
  https://auth.localhost/realms/recallapp
end note

iam --> iamdb : jdbc

' доверие и сертификаты
ca --> certs : генерирует rootCA + *.localhost
certs --> edge : server.crt/key
certs --> bff : rootCA (update-ca-certificates \n в entrypoint)
certs --> winca : импорт rootCA вручную (п.5)

' будущее
component "Monolith \n (ASP.NET Core)" as mono #eeeeee
bff ..> mono : API (YARP), появится позже

legend right
  Единый origin через edge-прокси: решает Mismatched Issuer,
  Secure-cookie (реальный https), HTTP/2 (мультиплексирование).
  BFF статику SPA НЕ отдаёт - это делает edge-прокси.
endlegend

@enduml
