<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true">
  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
  </extensions>
  <targets>
    <target name="console" xsi:type="Console">
      <layout>${time}|${level:uppercase=true}|${message}${onexception: | ${exception:format=message,type}}</layout>
    </target>
    <target name="appFile" xsi:type="File" fileName="${basedir}/logs/${shortdate}.app.log">
      <layout>${longdate}|${aspnet-traceidentifier}|${level:uppercase=true}|${logger}|${message} ${all-event-properties:includeScopeProperties=true}${onexception:${newline}${exception:format=tostring}}</layout>
    </target>
    <target name="httpFile" xsi:type="File" fileName="${basedir}/logs/${shortdate}.http.log">
      <layout>${longdate}|${aspnet-traceidentifier}|${level:uppercase=true}|${logger}|${message} ${all-event-properties:includeScopeProperties=true}${onexception:${newline}${exception:format=tostring}}</layout>
    </target>
  </targets>
  <rules>
    <logger name="*" minlevel="Info" writeTo="console">
      <filters defaultAction="Log">
        <whenContains layout="${aspnet-request-url}" substring="/health" action="Ignore" />
      </filters>
    </logger>
    <logger name="*" minlevel="Debug" writeTo="appFile">
      <filters defaultAction="Log">
        <whenContains layout="${aspnet-request-url}" substring="/health" action="Ignore" />
      </filters>
    </logger>
    <!-- Инфраструктурный HTTP-шум ASP.NET Core в отдельный access-лог (final, чтобы не дублировать в appFile) -->
    <logger name="Microsoft.AspNetCore.*" minlevel="Info" writeTo="httpFile" final="true">
      <filters defaultAction="Log">
        <whenContains layout="${aspnet-request-url}" substring="/health" action="Ignore" />
      </filters>
    </logger>
  </rules>
</nlog>
