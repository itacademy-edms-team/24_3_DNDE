# Dev-образ App.
# Исходники копируются на этапе сборки (bind-mount не используется): контейнер самодостаточен.
FROM mcr.microsoft.com/dotnet/sdk:8.0

WORKDIR /src
COPY . .
RUN dotnet build src/Api/Api.csproj -c Debug

EXPOSE 8080

# entrypoint:
# доверяем Root CA из тома shared_certs (JWT-валидация ходит за metadata/JWKS на https://auth.localhost);
# update-ca-certificates требует root, поэтому dev-контейнер работает от root.
# запускаем уже собранный Api.
ENTRYPOINT ["/bin/sh", "-c", "\
  if [ -f /certs/rootCA.pem ]; then \
  cp /certs/rootCA.pem /usr/local/share/ca-certificates/recallapp-dev-ca.crt && update-ca-certificates >/dev/null 2>&1; \
  fi; \
  exec dotnet /src/src/Api/bin/Debug/net8.0/Api.dll"]
